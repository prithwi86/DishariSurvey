<div class="qcard<%= c.flagged ? ' is-flagged' : '' %>" style="gap:8px" id="c<%= c.id %>">
  <div class="cmt-h"><span class="avatar"><%= fmt.initial(c.display_name) %></span><b><%= c.display_name %></b><span class="text-muted" style="font-size:11px" title="<%= fmt.formatDateTime(c.created_at) %>"><%= fmt.relativeTime(c.created_at) %></span>
    <span style="margin-left:auto;display:inline-flex;align-items:center;gap:6px">
      <% if (c.flagged) { %><span class="tag tag-outline">Flagged</span><% } %>
      <%- include('../partials/flag-form', { c: c }) %>
    </span>
  </div>
  <p class="pre" style="margin:0;font-size:14px;text-wrap:pretty;<%= c.flagged ? 'color:var(--color-neutral-600)' : '' %>"><%= c.body %></p>
</div>
