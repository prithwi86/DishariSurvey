<form method="post" action="/admin/surveys/<%= survey.id %>/comments/<%= c.id %>/flag"><input type="hidden" name="_csrf" value="<%= csrf() %>"><input type="hidden" name="n" value="<%= question.position %>"><input type="hidden" name="flagged" value="<%= c.flagged ? '0' : '1' %>"><button type="submit" class="icobtn" style="font-size:12px;color:var(--color-neutral-600)" title="<%= c.flagged ? 'Unflag: include in reports again' : 'Flag: hide from the PDF report' %>"><%- icon('flag', 'sm') %><%= c.flagged ? 'Unflag' : 'Flag' %></button></form>
